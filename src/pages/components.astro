---
import '@/styles/global.css';

// The preview page is generated into `public/components-preview.html` by
// `scripts/build-components-preview.mjs` (wired to `prebuild`). It is embedded
// in an iframe on purpose: the library ships its own `--fc-*` variables, its own
// Poppins from Google Fonts and its own base styles, and the iframe keeps all of
// that from colliding with global.css/Tailwind in either direction.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>ph-winds · Components</title>
    <meta
      name="description"
      content="Live preview of the @pepperhorn/fingering-components key shapes and fingering charts."
    />
  </head>
  <body class="wc-components-body h-dvh overflow-hidden">
    <div class="wc-components-page flex h-full flex-col">
      <header
        class="wc-components-header flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-hairline bg-surface/80 px-4 py-3 backdrop-blur sm:px-6"
      >
        <h1 class="wc-components-title order-1 text-lg font-semibold tracking-tight text-ink sm:text-xl">
          Fingering components
        </h1>
        <a
          class="btn-back order-2 ml-auto shrink-0 rounded-full border border-accent/30 px-3 py-1.5 text-sm font-medium text-accent transition hover:bg-accent-soft sm:order-3 sm:ml-0"
          href="/">&larr; Wind cards</a
        >
        <p
          class="wc-components-tagline order-3 w-full min-w-0 text-sm text-muted sm:order-2 sm:w-auto sm:flex-1"
        >
          Every key shape, state and instrument chart rendered straight from <code
            class="wc-components-package rounded bg-accent-soft px-1.5 py-0.5 text-[0.8em] text-accent"
            >@pepperhorn/fingering-components</code
          >.
        </p>
      </header>

      <iframe
        class="wc-components-frame min-h-0 w-full flex-1 border-0"
        src="/components-preview.html"
        title="Fingering chart components preview"
        loading="lazy"></iframe>
    </div>
  </body>
</html>
